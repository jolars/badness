---
source: tests/parser.rs
expression: "tree(\"\\\\[\\n  x + y\\n\\\\]\\nand \\\\( a \\\\)\")"
---
ROOT@0..25
  PARAGRAPH@0..25
    DISPLAY_MATH@0..13
      CONTROL_SYMBOL@0..2 "\\["
      MATH@2..11
        NEWLINE@2..3 "\n"
        WHITESPACE@3..5 "  "
        WORD@5..6 "x"
        WHITESPACE@6..7 " "
        WORD@7..8 "+"
        WHITESPACE@8..9 " "
        WORD@9..10 "y"
        NEWLINE@10..11 "\n"
      CONTROL_SYMBOL@11..13 "\\]"
    NEWLINE@13..14 "\n"
    WORD@14..17 "and"
    WHITESPACE@17..18 " "
    INLINE_MATH@18..25
      CONTROL_SYMBOL@18..20 "\\("
      MATH@20..23
        WHITESPACE@20..21 " "
        WORD@21..22 "a"
        WHITESPACE@22..23 " "
      CONTROL_SYMBOL@23..25 "\\)"
